{
  "name": "v4",
  "description": "Business-focused web design and development portfolio for Pius Shedrach",
  "version": "2.0.0",
  "type": "module",
  "author": "Pius Shedrach <piusshedrachdev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/piusshedrach/piusshedrach"
  },
  "keywords": [
    "vite",
    "react",
    "portfolio"
  ],
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "react-router build && node tools/generate-seo.js",
    "clean": "node tools/clean.js",
    "develop": "react-router dev",
    "start": "react-router dev",
    "preview": "vite preview --outDir build/client",
    "serve": "npm run preview",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,css}\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky install",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,css,json,md}": [
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@react-router/node": "^8.0.0",
    "animejs": "^3.2.2",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-text": "^4.0.2",
    "isbot": "^5.1.31",
    "lodash": "^4.17.21",
    "prismjs": "^1.30.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.0.0",
    "react-transition-group": "^4.4.5",
    "rehype-external-links": "^3.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "scrollreveal": "^4.0.9",
    "styled-components": "^6.1.19",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@react-router/dev": "^8.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@1.22.22"
}
